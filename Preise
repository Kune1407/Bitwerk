<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Preise – BitWerk</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #eef2f5;
            color: #222;
        }

        /* Kopfbereich */

        header {
            background-color: #123b5d;
            color: white;
            padding: 20px 50px;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        header img {
            width: 220px;
            height: auto;
        }

        header h1 {
            margin: 0;
            font-size: 36px;
        }

        /* Hauptbereich */

        main {
            max-width: 700px;
            margin: 50px auto;
            padding: 0 20px;
        }

        .karte {
            background-color: white;
            padding: 35px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        h2 {
            color: #123b5d;
            margin-top: 0;
            border-bottom: 2px solid #d9e3ea;
            padding-bottom: 12px;
        }

        /* Preise */

        .preis {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            padding: 15px 0;
            border-bottom: 1px solid #ddd;
        }

        .preis:last-of-type {
            border-bottom: none;
        }

        .betrag {
            font-weight: bold;
            white-space: nowrap;
        }

        /* Zurück-Link */

        .zurueck {
            display: inline-block;
            margin-top: 25px;
            color: #123b5d;
            text-decoration: none;
            font-weight: bold;
        }

        .zurueck:hover {
            text-decoration: underline;
        }

        /* Fußbereich */

        footer {
            background-color: #0d2c44;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

    </style>
</head>


<body>

    <!-- Kopfbereich -->

    <header>

        <img src="bilder/logo.png" alt="BitWerk Logo">

        <h1>Preise</h1>

    </header>


    <main>

        <section class="karte">

            <h2>Preise</h2>

            <div class="preis">

                <span>
                    Diagnose &amp; Kostenvoranschlag
                </span>

                <span class="betrag">
                    kostenlos
                </span>

            </div>


            <div class="preis">

                <span>
                    Notebook-/PC-Reinigung
                </span>

                <span class="betrag">
                    39 €
                </span>

            </div>


            <div class="preis">

                <span>
                    Datenerrettung
                </span>

                <span class="betrag">
                    ab 79 €
                </span>

            </div>


            <div class="preis">

                <span>
                    Einrichtung neuer Geräte
                </span>

                <span class="betrag">
                    49 €
                </span>

            </div>


            <a class="zurueck" href="index.html">
                ← Zurück zur Startseite
            </a>

        </section>

    </main>


    <footer>

        <p>
            © 2026 BitWerk Oldenburg
        </p>

    </footer>

</body>

</html>
