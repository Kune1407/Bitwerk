<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BitWerk Oldenburg</title>

    <style>

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #eef2f5;
            color: #222;
        }

        /* Kopfbereich */
        header {
            background-color: #123b5d;
            color: white;
            padding: 20px 50px;
            display: flex;
            align-items: center;
            gap: 30px;
        }

        header img {
            width: 220px;
            height: auto;
            display: block;
        }

        .kopftext h1 {
            margin: 0;
            font-size: 36px;
        }

        .kopftext p {
            margin: 8px 0 0;
            font-size: 18px;
        }

        /* Hauptbereich */
        main {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Karten */
        .karte {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            margin-bottom: 25px;
        }

        h2 {
            color: #123b5d;
            margin-top: 0;
            border-bottom: 2px solid #d9e3ea;
            padding-bottom: 10px;
        }

        .willkommen h2 {
            border-bottom: none;
            padding-bottom: 0;
        }

        /* Leistungen und Öffnungszeiten */
        .bereich {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        .bereich .karte {
            flex: 1;
            min-width: 280px;
        }

        ul {
            padding-left: 25px;
        }

        li {
            margin-bottom: 8px;
        }

        /* Pfeile zu den anderen Seiten */
        .seiten-links {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            margin-bottom: 25px;
        }

        .seiten-links a {
            display: block;
            color: #123b5d;
            text-decoration: none;
            font-weight: bold;
            padding: 8px 0;
        }

        .seiten-links a:hover {
            text-decoration: underline;
        }

        /* Karriere-Link */
        .kontakt-link {
            display: inline-block;
            color: #123b5d;
            font-weight: bold;
            text-decoration: none;
            margin-top: 10px;
        }

        .kontakt-link:hover {
            text-decoration: underline;
        }

        /* Fußbereich */
        footer {
            background-color: #0d2c44;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

        /* Anpassung für kleinere Bildschirme */
        @media (max-width: 650px) {

            header {
                padding: 20px;
                gap: 15px;
            }

            header img {
                width: 130px;
            }

            .kopftext h1 {
                font-size: 25px;
            }

            .kopftext p {
                font-size: 14px;
            }

        }

    </style>
</head>


<body>

    <!-- Kopfbereich -->

    <header>

        <img src="bilder/logo.png" alt="BitWerk Logo">

        <div class="kopftext">

            <h1>BitWerk Oldenburg</h1>

            <p>
                Reparatur von Computern und Elektronik
            </p>

        </div>

    </header>


    <main>

        <!-- Willkommen -->

        <section class="karte willkommen">

            <h2>Herzlich willkommen bei BitWerk!</h2>

            <p>
                Willkommen bei BitWerk Oldenburg – Ihrer Anlaufstelle
                für Computer und Elektronik.
            </p>

            <p>
                Wir reparieren Notebooks, PCs, Smartphones und kleine
                Elektrogeräte. Schnell, fair und zu Ihrer Nähe.
            </p>

        </section>


        <!-- Leistungen und Öffnungszeiten -->

        <div class="bereich">

            <section class="karte">

                <h2>Leistungen</h2>

                <ul>

                    <li>Diagnose und Kostenvoranschlag</li>
                    <li>Reparatur von Hardware</li>
                    <li>Datensicherung</li>
                    <li>Datenerrettung</li>
                    <li>Einrichtung neuer Geräte</li>

                </ul>

            </section>


            <section class="karte">

                <h2>Öffnungszeiten</h2>

                <p>
                    <strong>Montag – Freitag</strong><br>
                    09:00 – 18:00 Uhr
                </p>

                <p>
                    <strong>Samstag</strong><br>
                    10:00 – 14:00 Uhr
                </p>

                <p>
                    <strong>Sonntag</strong><br>
                    Geschlossen
                </p>

            </section>

        </div>


        <!-- Warum BitWerk -->

        <section class="karte">

            <h2>Warum BitWerk?</h2>

            <p>
                Bei uns stehen faire Preise, persönliche Beratung
                und eine schnelle Bearbeitung im Mittelpunkt.
            </p>

            <ul>

                <li>Faire und transparente Preise</li>
                <li>Persönliche Beratung</li>
                <li>Erfahrene Mitarbeiter</li>
                <li>Schnelle Reparaturen</li>
                <li>Hilfe auch bei kleinen Problemen</li>

            </ul>

        </section>


        <!-- Karriere -->

        <section class="karte">

            <h2>Karriere bei BitWerk</h2>

            <p>
                Du interessierst dich für Computer, Elektronik und
                Technik? Dann könnte BitWerk der richtige Arbeitsplatz
                für dich sein.
            </p>

            <p>
                Wir bieten interessante Möglichkeiten in den Bereichen
                IT, Reparatur, Technik und Kundenservice.
            </p>

            <ul>

                <li>Ausbildungsplätze</li>
                <li>Praktikumsplätze</li>
                <li>Jobs im IT-Bereich</li>
                <li>Weiterbildungsmöglichkeiten</li>

            </ul>

            <a class="kontakt-link" href="kontakt.html">
                → Interesse? Kontakt aufnehmen
            </a>

        </section>


        <!-- Zusätzlicher Kontaktbereich -->

        <section class="karte">

            <h2>Du hast ein technisches Problem?</h2>

            <p>
                Egal ob Computer, Smartphone oder anderes
                Elektrogerät – wir helfen dir gerne weiter.
            </p>

        </section>


        <!-- Links wie in der Kundenskizze -->

        <section class="seiten-links">

            <a href="preise.html">
                → Preise
            </a>

            <a href="kontakt.html">
                → Kontakt &amp; Anfahrt
            </a>

        </section>

    </main>


    <footer>

        <p>
            © 2026 BitWerk Oldenburg
        </p>

    </footer>

</body>

</html>
